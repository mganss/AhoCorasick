<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the same sources as AhoCorasick.SqlClr.sqlproj, so that a change to the library that
    breaks the SQL CLR functions fails the build instead of being found when the SQL CLR script is
    regenerated. Only a compile check: building the .sqlproj itself needs SSDT, which the build
    agents do not have, and that is only needed to produce AhoCorasick.SqlClr/dist.
  -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <RootNamespace>AhoCorasick.SqlClr</RootNamespace>
    <DefineConstants>NET40</DefineConstants>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <SonarQubeExclude>true</SonarQubeExclude>
    <!--
      The generated SQL CLR script embeds this assembly, so the same sources should give the same
      script. Deterministic is the default, but the compiler also records the paths of the source
      files, which differ between a local checkout and the build agent, so map the repository root
      to a fixed path. The version is pinned for the same reason. The .NET SDK is an input too: a
      different SDK can still produce different bytes.
    -->
    <Deterministic>true</Deterministic>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))=/_/</PathMap>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <!-- Without this the SDK asks git for the commit and puts it into both
         AssemblyInformationalVersion and the Source Link document of the pdb, together with the
         absolute path of the checkout, so the assembly would change with every commit and differ
         between checkouts. This assembly is embedded in a SQL script rather than shipped for
         debugging, so Source Link has no use here. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same files, in the same order, as the Compile items of the .sqlproj. -->
    <Compile Include="..\AhoCorasick\AhoCorasick.cs" Link="AhoCorasick.cs" />
    <Compile Include="..\AhoCorasick\CharComparer.cs" Link="CharComparer.cs" />
    <Compile Include="..\AhoCorasick\Trie.cs" Link="Trie.cs" />
    <Compile Include="..\AhoCorasick.SqlClr\Contains.cs" Link="Contains.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
</Project>
